# Data dir (SQLite DB, secret key, screenshots live here)
LBT1_DATA_DIR=./data
LBT1_DB_PATH=./data/lbt1.db

# Public-facing URL — used in password-reset emails
LBT1_BASE_URL=http://127.0.0.1:8000

# Cookie session secret. Leave blank locally (a stable one is auto-generated
# into data/.secret_key). In production, set this to a random 48+ byte string.
LBT1_SECRET_KEY=

# Session lifetime
LBT1_SESSION_TTL_DAYS=30

# VIN retention (lookups older than this are auto-purged)
LBT1_VIN_RETENTION_DAYS=60

# SMTP — all optional. If unset, signup/reset/newsletter emails are skipped
# silently (signup still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
EMAIL_FROM=Locksmith Brain <noreply@locksmithbrain.local>

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=60000
